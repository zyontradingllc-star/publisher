# Cloudflare Turnstile (Contact form bot protection)
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Add hostnames: localhost + authorspilot.com + www.authorspilot.com
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Legacy — Google reCAPTCHA v2 (unused; prefer Turnstile above)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional — Resend API for blog verification emails (recommended)
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Authors Pilot <info@authorspilot.com>
ADMIN_EMAIL=info@authorspilot.com

# Site URL — match your dev port (e.g. http://localhost:3456)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Publishing platform links from the marketing site
# Local unified (same origin via middleware proxy): leave EMPTY
# WARNING: Do not set http://localhost:3001 — it gets baked into live HTML.
# Only set https://app.authorspilot.com in .env.production AFTER that host is live.
NEXT_PUBLIC_PLATFORM_URL=
