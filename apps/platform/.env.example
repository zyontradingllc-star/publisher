# Authors Pilot Platform — copy to .env.local (never commit real secrets)
# Intended production URL: https://app.authorspilot.com

# --- Public URLs ---
# Public origin in local unified mode is the marketing host (:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Marketing site (old website) — local :3000 · production authorspilot.com
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# --- Firebase (Google) — Auth + Firestore + Storage ---
# Console: https://console.firebase.google.com → Project settings
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Service account (Project settings → Service accounts → Generate new private key)
# Paste private_key with \n escaped as a single line, or use real newlines in .env.local quotes
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Enable in Firebase Console:
# - Authentication → Sign-in method → Email/Password
# - Firestore Database (create in production mode, then deploy rules)
# - Storage
# - Authentication → Templates → customize Password reset (from address)

# --- Transactional email (optional Resend for custom mail; Firebase also sends reset emails) ---
RESEND_API_KEY=
EMAIL_FROM=Authors Pilot <no-reply@authorspilot.com>
ADMIN_NOTIFICATION_EMAIL=hello@authorspilot.com

# --- Upload limits (bytes) ---
MAX_COVER_BYTES=5242880
MAX_MANUSCRIPT_BYTES=26214400

# --- Payload CMS + MongoDB (Book Submissions) ---
# CMS (via unified local URL): http://localhost:3000/cms
# Required for Book Details form → BookSubmissions persistence
# Local:
# DATABASE_URL=mongodb://127.0.0.1:27017/authorspilot
# Atlas (preferred):
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/authorspilot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/authorspilot?retryWrites=true&w=majority
PAYLOAD_SECRET=replace-with-a-long-random-string

